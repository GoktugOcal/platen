# Copy to .env and adjust. All settings are optional.

# Web UI port (host networking).
# PLATEN_PORT=8631

# Login password. Leave empty only on a trusted network.
# PLATEN_PASSWORD=change-me

# Printers, comma-separated "Name=URI" or "URI". Empty = discover via mDNS.
# PLATEN_PRINTERS=Office=ipp://192.168.1.50/ipp/print

# Scanners for sane-airscan, comma-separated "Name=URL". Discovery is on by default.
# PLATEN_SCANNERS=Office=http://192.168.1.50:8080/eSCL
# PLATEN_SCANNER_DISCOVERY=true

# Days to keep uploaded files and scanned PDFs (job records are kept).
# PLATEN_RETENTION_DAYS=30

# Timezone for timestamps in the UI.
# TZ=Europe/Berlin
