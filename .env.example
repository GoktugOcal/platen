# Copy to .env and adjust. All settings are optional.

# Web UI port (host networking).
# PLATEN_PORT=8631

# First admin. If no users exist yet, an admin "admin" is created with this password.
# Leave empty to create the first admin on the /setup page instead.
# PLATEN_PASSWORD=change-me-please

# Remote access: Platen does not ship its own; put any reverse proxy, tunnel or VPN in
# front of it (see README "Remote access"). Proxies whose X-Forwarded-* headers are
# trusted (comma-separated IPs, or * if the port is only reachable by the proxy):
# PLATEN_TRUSTED_PROXIES=127.0.0.1
# Bind only to localhost when everything goes through a local proxy/tunnel:
# PLATEN_HOST=127.0.0.1

# Page quotas: block (refuse jobs over quota) or warn (only show usage).
# PLATEN_QUOTA_MODE=block
# Minutes between toner level samples for the dashboard (0 = off).
# PLATEN_SUPPLY_SAMPLE_MINUTES=360

# Printers and scanners are found on the network automatically (mDNS). Add devices that
# discovery cannot see (other subnet, WSD-only scanners) here, comma-separated "Name=URI".
# PLATEN_PRINTERS=Office=ipp://192.168.1.50/ipp/print
# PLATEN_SCANNERS=Office=http://192.168.1.50:8080/eSCL
# PLATEN_DISCOVER_PRINTERS=true
# PLATEN_SCANNER_DISCOVERY=true
# Minutes between discovery runs (0 = only at start and on "Search again").
# PLATEN_DISCOVERY_INTERVAL=10

# Scan-to-email. Gmail: create an app password at https://myaccount.google.com/apppasswords
# PLATEN_SMTP_HOST=smtp.gmail.com
# PLATEN_SMTP_PORT=587
# PLATEN_SMTP_SECURITY=starttls
# PLATEN_SMTP_USER=you@gmail.com
# PLATEN_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# PLATEN_SMTP_FROM=you@gmail.com
# PLATEN_EMAIL_MAX_MB=18

# Paperless-ngx. Users can also set their own API token on the Account page.
# PLATEN_PAPERLESS_URL=http://paperless.lan:8000
# PLATEN_PAPERLESS_TOKEN=

# Office documents (needs: docker compose --profile office up -d)
# PLATEN_GOTENBERG_URL=http://127.0.0.1:3100

# Postgres instead of SQLite (optional).
# PLATEN_DATABASE_URL=postgresql+psycopg://platen:secret@127.0.0.1:5432/platen

# Days to keep uploaded files and scanned PDFs (job records are kept).
# PLATEN_RETENTION_DAYS=30

# Timezone for timestamps in the UI.
# TZ=Europe/Berlin
